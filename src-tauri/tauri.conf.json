{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimVizion Mod Manager",
  "version": "0.9.0-beta.1",
  "identifier": "com.simvizion.modmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SimVizion Mod Manager",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://thumb.localhost; style-src 'self' 'unsafe-inline'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "SimVizion",
    "copyright": "Copyright (c) 2026 SimVizion",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Mod folders, profiles and updates for Farming Simulator 25",
    "longDescription": "SimVizion Mod Manager organises Farming Simulator 25 mod folders as profiles, switches between them safely, checks mods and savegames, and updates mods from ModHub and GitHub.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "SimVizion"
      }
    },
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1REMwNEEyOUE4Q0E1QzIKUldUQ3BZeWFvZ1RjZFpjMlhyVzZITlQ4dSt6R09SYnFNOVVpeGU5Y1E1QnpxZ2xob0pnTGp2ZzkK",
      "endpoints": [
        "https://github.com/206airmail/SimVizion-FS-ModManager/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
